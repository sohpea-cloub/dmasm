index 5ead4a9..18c636b 100644
--- a/crates/dreammaker/src/parser.rs
+++ b/crates/dreammaker/src/parser.rs
@@ -2826,20 +2826,27 @@ impl<'ctx, 'an, 'inp> Parser<'ctx, 'an, 'inp> {
         let start = self.location;
 
