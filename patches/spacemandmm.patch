index e573a4f..9c3de32 100644
--- a/crates/dreammaker/src/preprocessor.rs
+++ b/crates/dreammaker/src/preprocessor.rs
@@ -1204,30 +1204,48 @@ impl<'ctx> Preprocessor<'ctx> {
 
                         self.annotate_macro(ident, location, Some(docs));
 
-                        // read arguments
+                        // read arguments, and where each token was, for `#arg`
                         let mut args = Vec::new();
+                        let mut arg_spans = Vec::new();
+                        // spaces between an argument's last token and the `,` or `)` after it
+                        let mut arg_trailing = Vec::new();
                         let mut this_arg = Vec::new();
+                        let mut this_spans = Vec::new();
                         let mut parens = 0;
                         loop {
-                            let token = next!();
