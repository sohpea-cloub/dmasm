                                     this_arg.push(token);
+                                    this_spans.push(span);
                                 },
                                 Token![')'] => {
                                     if parens == 0 {
+                                        arg_trailing.push(trailing_gap(&this_spans, span.0));
                                         args.push(this_arg);
